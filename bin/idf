#!/bin/bash
#
# TIC test build/flash/monitor helper
#
# Usage:
#   bin/idf [actions...] [options...] [targets...]
#
# Actions:
#   clean    - Clean build directory
#   build    - Build firmware
#   flash    - Flash to device(s)
#   monitor  - Monitor serial output
#
# Options:
#   -f, --freq HZ       - Signal generator frequency (default: 2000)
#   --freq-b HZ         - Generator B frequency (default: same as --freq)
#   -d, --delay NS      - Channel B delay in ns (default: 0)
#   -m, --mode MODE     - Build mode: loopback or normal (default: normal)
#   -b, --build-dir DIR - Custom build directory (default: build/<mode>)
#   --csv               - Enable CSV output format
#   --binary            - Enable binary USB CDC output
#   --wifi              - Enable WiFi MQTT transport
#   --no-reset          - Don't reset on monitor
#
# Targets:
#   tic1, tic2, tic3, tic4, tic5, tic6 - Individual devices
#   all                          - All devices
#
# Device-specific config:
#   Create sdkconfig.defaults.ticN to override settings for a specific device.
#   When building for a single device with custom config, a separate build
#   directory is used (e.g., build/normal-tic6).
#
# Examples:
#   bin/idf build flash tic1           # Build normal, flash to TIC1
#   bin/idf -m loopback build tic1     # Build loopback mode
#   bin/idf -f 5000 -d 100 build       # Build with 5kHz, 100ns delay
#   bin/idf flash monitor tic1         # Flash and monitor TIC1
#   bin/idf build flash tic6           # Uses sdkconfig.defaults.tic6 if exists
#

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

# Load .env
if [[ ! -f "$PROJECT_DIR/.env" ]]; then
    echo "ERROR: $PROJECT_DIR/.env not found. Copy .env.sample and configure." >&2
    exit 1
fi
source "$PROJECT_DIR/.env"

# Expand $HOME in IDF_PATH
eval IDF_PATH="$IDF_PATH"

# Validate IDF_TARGET
if [[ -z "$IDF_TARGET" ]]; then
    echo "ERROR: IDF_TARGET not set in .env" >&2
    exit 1
fi

# ESP-IDF export script
ESP_IDF_EXPORT="$IDF_PATH/export.sh"
if [[ ! -f "$ESP_IDF_EXPORT" ]]; then
    echo "ERROR: $ESP_IDF_EXPORT not found" >&2
    exit 1
fi

# Defaults
DO_CLEAN=false
DO_BUILD=false
DO_FLASH=false
DO_MONITOR=false
NO_RESET=false
CSV_OUTPUT=false
BINARY_OUTPUT=false
WIFI_OUTPUT=false
MODE="normal"
FREQ_HZ=2000
FREQ_B_HZ=""
DELAY_NS=0
CUSTOM_BUILD_DIR=""
TARGETS=()

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        clean)
            DO_CLEAN=true
            shift
            ;;
        build)
            DO_BUILD=true
            shift
            ;;
        flash)
            DO_FLASH=true
            shift
            ;;
        monitor)
            DO_MONITOR=true
            shift
            ;;
        -f|--freq)
            FREQ_HZ="$2"
            shift 2
            ;;
        --freq-b)
            FREQ_B_HZ="$2"
            shift 2
            ;;
        -d|--delay)
            DELAY_NS="$2"
            shift 2
            ;;
        -m|--mode)
            MODE="$2"
            shift 2
            ;;
        --no-reset)
            NO_RESET=true
            shift
            ;;
        --csv)
            CSV_OUTPUT=true
            shift
            ;;
        --binary)
            BINARY_OUTPUT=true
            shift
            ;;
        --wifi)
            WIFI_OUTPUT=true
            shift
            ;;
        -b|--build-dir)
            CUSTOM_BUILD_DIR="$2"
            shift 2
            ;;
        tic1|tic2|tic3|tic4|tic5|tic6|all)
            TARGETS+=("$1")
            shift
            ;;
        -h|--help)
            sed -n '2,28p' "$0" | sed 's/^#//' | sed 's/^ //'
            exit 0
            ;;
        *)
            echo "Unknown argument: $1"
            echo "Use --help for usage"
            exit 1
            ;;
    esac
done

# Default action is build
if [[ "$DO_CLEAN" == false && "$DO_BUILD" == false && "$DO_FLASH" == false && "$DO_MONITOR" == false ]]; then
    DO_BUILD=true
fi

# Default targets: tic1
if [[ ${#TARGETS[@]} -eq 0 ]]; then
    TARGETS=("tic1")
fi

# Expand 'all' target
expand_targets() {
    local expanded=()
    for t in "${TARGETS[@]}"; do
        if [[ "$t" == "all" ]]; then
            expanded+=("tic1" "tic2" "tic3" "tic4" "tic5" "tic6")
        else
            expanded+=("$t")
        fi
    done
    echo "${expanded[@]}"
}

# Get serial port for a target
get_port() {
    local target="$1"
    case "$target" in
        tic1) echo "$TIC1_SERIAL_PORT" ;;
        tic2) echo "$TIC2_SERIAL_PORT" ;;
        tic3) echo "$TIC3_SERIAL_PORT" ;;
        tic4) echo "$TIC4_SERIAL_PORT" ;;
        tic5) echo "$TIC5_SERIAL_PORT" ;;
        tic6) echo "$TIC6_SERIAL_PORT" ;;
    esac
}

# Generate sdkconfig content (dynamic runtime values only)
# GPIO mappings come from sdkconfig.defaults.{loopback,normal}
# Binary mode settings come from sdkconfig.defaults.binary
generate_sdkconfig() {
    local freq_b="${FREQ_B_HZ:-$FREQ_HZ}"

    cat << EOF
# Runtime configuration (generated by bin/idf)
CONFIG_TIC_SIGGEN_A_FREQ_HZ=$FREQ_HZ
CONFIG_TIC_SIGGEN_B_FREQ_HZ=$freq_b
CONFIG_TIC_SIGGEN_B_DELAY_NS=$DELAY_NS
EOF

    # CSV output (optional)
    if [[ "$CSV_OUTPUT" == true ]]; then
        echo "CONFIG_TIC_OUTPUT_CSV=y"
    fi
}

cd "$PROJECT_DIR"

# Source ESP-IDF
source "$ESP_IDF_EXPORT" > /dev/null 2>&1

# Check for device-specific config files
DEVICE_CONFIG=""
EXPANDED_TARGETS=($(expand_targets))
if [[ ${#EXPANDED_TARGETS[@]} -eq 1 ]]; then
    TARGET="${EXPANDED_TARGETS[0]}"
    if [[ -f "sdkconfig.defaults.$TARGET" ]]; then
        DEVICE_CONFIG="sdkconfig.defaults.$TARGET"
    fi
fi

# Set build directory (custom or default)
if [[ -n "$CUSTOM_BUILD_DIR" ]]; then
    BUILD_DIR="$CUSTOM_BUILD_DIR"
elif [[ -n "$DEVICE_CONFIG" ]]; then
    # Device-specific config requires separate build directory
    BUILD_DIR="build/$MODE-$TARGET"
else
    BUILD_DIR="build/$MODE"
fi
SDKCONFIG_FILE="$BUILD_DIR/sdkconfig.$MODE"

echo "=== TIC Build Helper ==="
echo "Target: $IDF_TARGET"
echo "Mode: $MODE"
[[ "$BINARY_OUTPUT" == true ]] && echo "Binary USB CDC: enabled"
[[ "$WIFI_OUTPUT" == true ]] && echo "WiFi MQTT: enabled"
[[ -n "$DEVICE_CONFIG" ]] && echo "Device config: $DEVICE_CONFIG"
echo "Build dir: $BUILD_DIR"
if [[ -n "$FREQ_B_HZ" ]]; then
    echo "Frequency A: $FREQ_HZ Hz"
    echo "Frequency B: $FREQ_B_HZ Hz"
else
    echo "Frequency: $FREQ_HZ Hz"
fi
echo "Delay B-A: $DELAY_NS ns"
echo "Targets: ${TARGETS[*]}"
echo ""

# Clean
if [[ "$DO_CLEAN" == true ]]; then
    echo "=== Cleaning $BUILD_DIR ==="
    rm -rf "$BUILD_DIR"
    echo ""
fi

# Build
if [[ "$DO_BUILD" == true ]]; then
    echo "=== Building ==="
    mkdir -p "$BUILD_DIR"

    # Generate new sdkconfig defaults (runtime values)
    NEW_SDKCONFIG=$(generate_sdkconfig)

    # Check if config changed
    if [[ -f "$SDKCONFIG_FILE" ]]; then
        OLD_SDKCONFIG=$(cat "$SDKCONFIG_FILE")
    else
        OLD_SDKCONFIG=""
    fi

    if [[ "$NEW_SDKCONFIG" != "$OLD_SDKCONFIG" ]]; then
        echo "Config changed, forcing rebuild..."
        echo "$NEW_SDKCONFIG" > "$SDKCONFIG_FILE"
        # Remove sdkconfig and cmake cache to force full regeneration
        rm -f "$BUILD_DIR/sdkconfig"
        rm -f "$BUILD_DIR/CMakeCache.txt"
    fi

    # Also check if sdkconfig.defaults is newer than build sdkconfig
    if [[ -f "$BUILD_DIR/sdkconfig" && "sdkconfig.defaults" -nt "$BUILD_DIR/sdkconfig" ]]; then
        echo "sdkconfig.defaults changed, forcing rebuild..."
        rm -f "$BUILD_DIR/sdkconfig"
        rm -f "$BUILD_DIR/CMakeCache.txt"
    fi

    # Check if mode-specific defaults changed
    if [[ -f "$BUILD_DIR/sdkconfig" && "sdkconfig.defaults.$MODE" -nt "$BUILD_DIR/sdkconfig" ]]; then
        echo "sdkconfig.defaults.$MODE changed, forcing rebuild..."
        rm -f "$BUILD_DIR/sdkconfig"
        rm -f "$BUILD_DIR/CMakeCache.txt"
    fi

    # Check if binary defaults changed (when binary mode enabled)
    if [[ "$BINARY_OUTPUT" == true && -f "$BUILD_DIR/sdkconfig" && "sdkconfig.defaults.binary" -nt "$BUILD_DIR/sdkconfig" ]]; then
        echo "sdkconfig.defaults.binary changed, forcing rebuild..."
        rm -f "$BUILD_DIR/sdkconfig"
        rm -f "$BUILD_DIR/CMakeCache.txt"
    fi

    # Check if wifi defaults changed (when wifi mode enabled)
    if [[ "$WIFI_OUTPUT" == true && -f "sdkconfig.defaults.wifi" && -f "$BUILD_DIR/sdkconfig" && "sdkconfig.defaults.wifi" -nt "$BUILD_DIR/sdkconfig" ]]; then
        echo "sdkconfig.defaults.wifi changed, forcing rebuild..."
        rm -f "$BUILD_DIR/sdkconfig"
        rm -f "$BUILD_DIR/CMakeCache.txt"
    fi

    # Check if device-specific defaults changed
    if [[ -n "$DEVICE_CONFIG" && -f "$BUILD_DIR/sdkconfig" && "$DEVICE_CONFIG" -nt "$BUILD_DIR/sdkconfig" ]]; then
        echo "$DEVICE_CONFIG changed, forcing rebuild..."
        rm -f "$BUILD_DIR/sdkconfig"
        rm -f "$BUILD_DIR/CMakeCache.txt"
    fi

    # Check if Kconfig.projbuild changed (defines available options)
    if [[ -f "$BUILD_DIR/sdkconfig" && "main/Kconfig.projbuild" -nt "$BUILD_DIR/sdkconfig" ]]; then
        echo "Kconfig.projbuild changed, forcing rebuild..."
        rm -f "$BUILD_DIR/sdkconfig"
        rm -f "$BUILD_DIR/CMakeCache.txt"
    fi

    # Build SDKCONFIG_DEFAULTS chain: base -> mode -> [binary] -> [wifi] -> [device] -> runtime
    DEFAULTS_CHAIN="sdkconfig.defaults;sdkconfig.defaults.$MODE"
    [[ "$BINARY_OUTPUT" == true ]] && DEFAULTS_CHAIN+=";sdkconfig.defaults.binary"
    [[ "$WIFI_OUTPUT" == true && -f "sdkconfig.defaults.wifi" ]] && DEFAULTS_CHAIN+=";sdkconfig.defaults.wifi"
    [[ -n "$DEVICE_CONFIG" ]] && DEFAULTS_CHAIN+=";$DEVICE_CONFIG"
    DEFAULTS_CHAIN+=";$SDKCONFIG_FILE"

    idf.py -B "$BUILD_DIR" \
        -DIDF_TARGET="$IDF_TARGET" \
        -DSDKCONFIG="$BUILD_DIR/sdkconfig" \
        -DSDKCONFIG_DEFAULTS="$DEFAULTS_CHAIN" \
        build
    echo ""
fi

# Flash
if [[ "$DO_FLASH" == true ]]; then
    echo "=== Flashing ==="
    for target in $(expand_targets); do
        port=$(get_port "$target")
        if [[ -z "$port" ]]; then
            echo "ERROR: No port configured for $target"
            continue
        fi
        echo "Flashing $target ($port)..."
        idf.py -B "$BUILD_DIR" -DSDKCONFIG="$BUILD_DIR/sdkconfig" -p "$port" flash
    done
    echo ""
fi

# Monitor
if [[ "$DO_MONITOR" == true ]]; then
    targets_array=($(expand_targets))

    MONITOR_ARGS=""
    [[ "$NO_RESET" == true ]] && MONITOR_ARGS="--no-reset"

    if [[ ${#targets_array[@]} -eq 1 ]]; then
        # Single monitor
        target="${targets_array[0]}"
        port=$(get_port "$target")
        echo "=== Monitoring $target ($port) ==="
        idf.py -B "$BUILD_DIR" -DSDKCONFIG="$BUILD_DIR/sdkconfig" -p "$port" monitor $MONITOR_ARGS
    else
        # Multiple monitors with tmux
        echo "=== Opening ${#targets_array[@]} monitors in tmux ==="
        tmux kill-session -t tic_monitor 2>/dev/null || true
        tmux new-session -d -s tic_monitor -x 200 -y 50

        FIRST_PANE=true
        for target in "${targets_array[@]}"; do
            port=$(get_port "$target")
            if [[ -z "$port" ]]; then
                continue
            fi

            if $FIRST_PANE; then
                FIRST_PANE=false
            else
                tmux split-window -t tic_monitor -v
            fi

            tmux send-keys -t tic_monitor \
                "cd '$PROJECT_DIR' && source '$ESP_IDF_EXPORT' > /dev/null 2>&1 && idf.py -B '$BUILD_DIR' -DSDKCONFIG='$BUILD_DIR/sdkconfig' -p '$port' monitor $MONITOR_ARGS" C-m
        done

        tmux select-layout -t tic_monitor even-vertical
        tmux select-pane -t tic_monitor:0.0
        tmux attach-session -t tic_monitor
    fi
fi

# Cleanup generated sdkconfig (keep it for reference during development)
# rm -f "$SDKCONFIG_FILE"

echo "Done!"
