# Copy to .env and configure
# Single-device tests require TIC1_SERIAL_PORT
# Multi-device tests require TIC[1-5]_SERIAL_PORT as needed

IDF_PATH="$HOME/esp/esp-idf"

# Serial console ports (UART - for stats output)
TIC1_SERIAL_PORT=/dev/tty.usbserial-0001
TIC2_SERIAL_PORT=/dev/tty.usbserial-0002
TIC3_SERIAL_PORT=/dev/tty.usbserial-0003
TIC4_SERIAL_PORT=/dev/tty.usbserial-0004
TIC5_SERIAL_PORT=/dev/tty.usbserial-0005

# USB CDC ports (OTG - for binary output, only needed for --binary mode)
# On macOS: /dev/tty.usbmodemXXXX (appears when binary firmware runs)
# On Linux: /dev/ttyACMX
TIC1_CDC_PORT=/dev/tty.usbmodem0001
TIC2_CDC_PORT=/dev/tty.usbmodem0002
TIC3_CDC_PORT=/dev/tty.usbmodem0003
TIC4_CDC_PORT=/dev/tty.usbmodem0004
TIC5_CDC_PORT=/dev/tty.usbmodem0005