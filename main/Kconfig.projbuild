menu "TIC Configuration"

    config TIC_INPUT_GPIO_A
        int "Channel A input GPIO"
        default 4
        range 0 48
        help
            GPIO pin for Channel A capture input.

    config TIC_INPUT_GPIO_B
        int "Channel B input GPIO"
        default 5
        range 0 48
        help
            GPIO pin for Channel B capture input.

    menu "Signal Generator"
        config TIC_SIGGEN_A_FREQ_HZ
            int "Generator A frequency (Hz), 0 to disable"
            default 1000
            range 0 1000000
            help
                Frequency for signal generator A. Set to 0 to disable.
                Loopback is auto-enabled if generator GPIO matches capture GPIO.

        config TIC_SIGGEN_A_GPIO
            int "Generator A GPIO"
            default 6
            range 0 48
            help
                GPIO pin for signal generator A output.
                Set equal to Channel A input GPIO for loopback mode.

        config TIC_SIGGEN_B_FREQ_HZ
            int "Generator B frequency (Hz), 0 to disable"
            default 1000
            range 0 1000000
            help
                Frequency for signal generator B. Set to 0 to disable.
                Loopback is auto-enabled if generator GPIO matches capture GPIO.

        config TIC_SIGGEN_B_GPIO
            int "Generator B GPIO"
            default 7
            range 0 48
            help
                GPIO pin for signal generator B output.
                Set equal to Channel B input GPIO for loopback mode.

        config TIC_SIGGEN_B_DELAY_NS
            int "Generator B relative delay (ns)"
            default 0
            range -1000000000 1000000000
            help
                Delay of generator B rising edge relative to A, in nanoseconds.
                Positive = B lags A, Negative = B leads A.
    endmenu

    config TIC_EXPECTED_FREQ_HZ
        int "Expected signal frequency (Hz) for external inputs"
        default 0
        range 0 1000000
        help
            Expected frequency of external input signals.
            Used to calculate max_delay for edge matching when
            internal signal generators are disabled.
            Set to 0 if using internal signal generators.

    config TIC_BUFFER_SIZE
        int "Buffer size (events)"
        default 16384
        range 256 32768
        help
            Number of events each buffer can hold.
            Two buffers are allocated (double buffering).
            Memory usage: 2 * BUFFER_SIZE * 8 bytes.
            Buffer swaps when full or when stats period expires.

    config TIC_STATS_PERIOD_MS
        int "Stats period (ms)"
        default 1000
        range 100 60000
        help
            Maximum time between statistics reports, even if edge count
            threshold is not reached. Ensures periodic output with slow signals.

    config TIC_OUTPUT_CSV
        bool "CSV output format"
        default n
        help
            Output statistics in CSV format instead of table format.
            Useful for automated testing and data processing.

    config TIC_OUTPUT_BINARY
        bool "Binary output mode (USB CDC)"
        default n
        help
            Output raw edge data in binary format over USB CDC (OTG port).
            Enables high-throughput streaming to host for external processing.
            Serial console output (UART) remains active for debugging.

    menu "WiFi MQTT Transport"
        config TIC_WIFI_ENABLED
            bool "Enable WiFi MQTT transport"
            default n
            help
                Stream binary frames over WiFi/MQTT instead of (or in addition to) USB CDC.
                Useful for ESP32-C6 which lacks USB OTG.

        config TIC_WIFI_SSID
            string "WiFi SSID"
            depends on TIC_WIFI_ENABLED
            default "your_wifi_ssid"
            help
                WiFi network name to connect to.

        config TIC_WIFI_PASSWORD
            string "WiFi Password"
            depends on TIC_WIFI_ENABLED
            default "your_wifi_password"
            help
                WiFi network password.

        config TIC_MQTT_BROKER
            string "MQTT Broker IP/hostname"
            depends on TIC_WIFI_ENABLED
            default "192.168.1.100"
            help
                MQTT broker address for publishing frames.

        config TIC_MQTT_PORT
            int "MQTT Broker Port"
            depends on TIC_WIFI_ENABLED
            default 1883
            range 1 65535
            help
                MQTT broker port number.

        config TIC_MQTT_TOPIC
            string "MQTT Topic prefix"
            depends on TIC_WIFI_ENABLED
            default "tic"
            help
                MQTT topic prefix. Device name will be appended: <prefix>/<device>/frames

        config TIC_DEVICE_NAME
            string "Device name for MQTT topic"
            depends on TIC_WIFI_ENABLED
            default "tic"
            help
                Device identifier used in MQTT topic: tic/<device>/frames

        config TIC_WIFI_RING_SIZE
            int "Frame ring buffer size"
            depends on TIC_WIFI_ENABLED
            default 20
            range 5 50
            help
                Number of frames to buffer when WiFi/MQTT is temporarily unavailable.
                Each frame is ~8KB, so 20 frames = ~160KB.
                Provides ~10 seconds of buffering at 2Hz frame rate.
    endmenu

endmenu
